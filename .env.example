# Music Assistant Docker image tag (latest, beta, or nightly)
# Note: use "beta" or "nightly" if "latest" does not yet support --dev-providers-dir
MA_IMAGE_TAG=beta

# Timezone
TZ=Europe/Paris

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# Host directory for Music Assistant persistent data
MA_DATA_DIR=./ma-data

# Optional: host path to your Lidarr-managed music library
# MUSIC_DIR=/mnt/music
